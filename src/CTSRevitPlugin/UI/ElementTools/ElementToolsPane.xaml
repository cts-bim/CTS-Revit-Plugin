<Page x:Class="CTSRevitPlugin.UI.ElementTools.ElementToolsPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#252525">

    <Page.Resources>

        <!-- ========================================================= -->
        <!-- COLORS -->
        <!-- ========================================================= -->

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#252525"/>

        <SolidColorBrush x:Key="CardBrush"
                         Color="#2D2D2D"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#414141"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F2F2F2"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#999999"/>

        <SolidColorBrush x:Key="AccentBrush"
                         Color="#FF4D23"/>


        <!-- ========================================================= -->
        <!-- COPY BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="CopyButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="28"/>

            <Setter Property="Height"
                    Value="24"/>

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="4,0,0,0"/>

            <Setter Property="Background"
                    Value="#353535"/>

            <Setter Property="Foreground"
                    Value="#CCCCCC"/>

            <Setter Property="BorderBrush"
                    Value="#4A4A4A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="13"/>

        </Style>


        <!-- ========================================================= -->
        <!-- ACTION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Background"
                    Value="#333333"/>

            <Setter Property="Foreground"
                    Value="#F2F2F2"/>

            <Setter Property="BorderBrush"
                    Value="#4A4A4A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <!-- ========================================================= -->
        <!-- SMALL ACTION BUTTON -->
        <!-- ========================================================= -->

        <Style x:Key="SmallActionButtonStyle"
               TargetType="Button">

            <Setter Property="Width"
                    Value="38"/>

            <Setter Property="Height"
                    Value="32"/>

            <Setter Property="Background"
                    Value="#333333"/>

            <Setter Property="Foreground"
                    Value="#F2F2F2"/>

            <Setter Property="BorderBrush"
                    Value="#4A4A4A"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

        </Style>


        <!-- ========================================================= -->
        <!-- FIELD LABEL -->
        <!-- ========================================================= -->

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#999999"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ========================================================= -->
        <!-- FIELD VALUE -->
        <!-- ========================================================= -->

        <Style x:Key="FieldValueStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#F2F2F2"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- ========================================================= -->
        <!-- SECTION TITLE -->
        <!-- ========================================================= -->

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#F2F2F2"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="Margin"
                    Value="0,0,0,8"/>

        </Style>


        <!-- ========================================================= -->
        <!-- UTILITY CHECKBOX -->
        <!-- ========================================================= -->

        <Style x:Key="UtilityCheckBoxStyle"
               TargetType="CheckBox">

            <Setter Property="Foreground"
                    Value="#F2F2F2"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="Margin"
                    Value="8,5,8,5"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

    </Page.Resources>


    <!-- ============================================================= -->
    <!-- MAIN -->
    <!-- ============================================================= -->

    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="#252525"
                BorderBrush="#3B3B3B"
                BorderThickness="0,0,0,1"
                Padding="12,12,10,12">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- CTS LOGO -->

                <Viewbox Grid.Column="0"
                         Width="36"
                         Height="36"
                         Margin="0,0,10,0">

                    <Canvas Width="100"
                            Height="100">

                        <Polygon
                            Points="50,25 64,34 50,43 36,34"
                            Fill="#FF4D23"/>

                        <Polygon
                            Points="26,42 50,58 74,42 84,49 50,71 16,49"
                            Fill="#FF4D23"/>

                        <Polygon
                            Points="12,61 50,86 88,61 98,68 50,100 2,68"
                            Fill="#FF4D23"/>

                    </Canvas>

                </Viewbox>


                <!-- TITLE -->

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">

                    <TextBlock Text="CTS ELEMENT TOOLS"
                               Foreground="#F2F2F2"
                               FontSize="15"
                               FontWeight="Bold"/>

                    <TextBlock Text="Element information &amp; tools"
                               Foreground="#777777"
                               FontSize="10"
                               Margin="0,2,0,0"/>

                </StackPanel>


                <!-- SETTINGS -->

                <Button Grid.Column="2"
                        x:Name="SettingsButton"
                        Content="⚙"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        Foreground="#AAAAAA"
                        BorderThickness="0"
                        FontSize="18"
                        Click="SettingsButton_Click"
                        ToolTip="CTS Element Tools Settings"/>

            </Grid>

        </Border>


        <!-- ========================================================= -->
        <!-- CONTENT -->
        <!-- ========================================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="12">


                <!-- ================================================= -->
                <!-- UTILITIES MENU -->
                <!-- ================================================= -->

                <Grid HorizontalAlignment="Left"
                      Margin="0,0,0,16">

                    <!-- ================================================= -->
                    <!-- SQUARE UTILITIES BUTTON -->
                    <!-- ================================================= -->

                    <Button x:Name="UtilitiesButton"
                            Width="82"
                            Height="82"
                            Padding="0"
                            Background="#2D2D2D"
                            Foreground="#F2F2F2"
                            BorderBrush="#414141"
                            BorderThickness="1"
                            Click="UtilitiesButton_Click">

                        <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">

                                    <Grid>

                                        <Grid.RowDefinitions>

                                            <RowDefinition Height="*"/>

                                            <RowDefinition Height="Auto"/>

                                            <RowDefinition Height="Auto"/>

                                        </Grid.RowDefinitions>


                                        <!-- ICON -->

                                        <TextBlock Grid.Row="0"
                                                   Text="⚙"
                                                   FontSize="25"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#CCCCCC"/>


                                        <!-- LABEL -->

                                        <TextBlock Grid.Row="1"
                                                   Text="UTILITIES"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#F2F2F2"
                                                   Margin="0,0,0,2"/>


                                        <!-- ARROW -->

                                        <TextBlock Grid.Row="2"
                                                   x:Name="UtilitiesArrow"
                                                   Text="▼"
                                                   FontSize="8"
                                                   HorizontalAlignment="Center"
                                                   Foreground="#999999"
                                                   Margin="0,0,0,5"/>

                                    </Grid>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>


                    <!-- ================================================= -->
                    <!-- DROPDOWN -->
                    <!-- ================================================= -->

                    <Border x:Name="UtilitiesMenu"
                            Visibility="Collapsed"
                            Width="170"
                            Background="#303030"
                            BorderBrush="#4A4A4A"
                            BorderThickness="1"
                            CornerRadius="3"
                            Margin="0,88,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Panel.ZIndex="100">

                        <StackPanel>

                            <TextBlock Text="UTILITIES"
                                       Foreground="#999999"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="10,8,10,4"/>


                            <!-- PARAMETERS -->

                            <CheckBox x:Name="ParametersUtilityCheck"
                                      Content="PARAMETERS"
                                      IsChecked="True"
                                      Style="{StaticResource UtilityCheckBoxStyle}"
                                      Checked="UtilityCheckBox_Changed"
                                      Unchecked="UtilityCheckBox_Changed"/>


                            <!-- SHORTCUTS -->

                            <CheckBox x:Name="ShortcutsUtilityCheck"
                                      Content="SHORTCUTS"
                                      IsChecked="True"
                                      Style="{StaticResource UtilityCheckBoxStyle}"
                                      Checked="UtilityCheckBox_Changed"
                                      Unchecked="UtilityCheckBox_Changed"/>


                            <!-- HANGERS -->

                            <CheckBox x:Name="HangersUtilityCheck"
                                      Content="HANGERS"
                                      IsChecked="True"
                                      Style="{StaticResource UtilityCheckBoxStyle}"
                                      Checked="UtilityCheckBox_Changed"
                                      Unchecked="UtilityCheckBox_Changed"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- PARAMETERS MODULE -->
                <!-- ================================================= -->

                <StackPanel x:Name="ParametersModule">

                    <TextBlock Text="PARAMETERS"
                               Style="{StaticResource SectionTitleStyle}"/>


                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <!-- ELEMENT ID -->

                            <Grid x:Name="ElementIdRow"
                                  Margin="0,2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="78"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="32"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Element ID"
                                           Style="{StaticResource FieldLabelStyle}"/>


                                <TextBlock Grid.Column="1"
                                           x:Name="IdValue"
                                           Style="{StaticResource FieldValueStyle}"/>


                                <Button Grid.Column="2"
                                        x:Name="CopyIdButton"
                                        Content="⧉"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Click="CopyId_Click"
                                        ToolTip="Copy Element ID"/>

                            </Grid>


                            <!-- CATEGORY -->

                            <Grid x:Name="CategoryRow"
                                  Margin="0,2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="78"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="32"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Category"
                                           Style="{StaticResource FieldLabelStyle}"/>


                                <TextBlock Grid.Column="1"
                                           x:Name="CategoryValue"
                                           Style="{StaticResource FieldValueStyle}"/>


                                <Button Grid.Column="2"
                                        x:Name="CopyCategoryButton"
                                        Content="⧉"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Click="CopyCategory_Click"
                                        ToolTip="Copy Category"/>

                            </Grid>


                            <!-- FAMILY -->

                            <Grid x:Name="FamilyRow"
                                  Margin="0,2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="78"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="32"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Family"
                                           Style="{StaticResource FieldLabelStyle}"/>


                                <TextBlock Grid.Column="1"
                                           x:Name="FamilyValue"
                                           Style="{StaticResource FieldValueStyle}"/>


                                <Button Grid.Column="2"
                                        x:Name="CopyFamilyButton"
                                        Content="⧉"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Click="CopyFamily_Click"
                                        ToolTip="Copy Family"/>

                            </Grid>


                            <!-- TYPE -->

                            <Grid x:Name="TypeRow"
                                  Margin="0,2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="78"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="32"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Type"
                                           Style="{StaticResource FieldLabelStyle}"/>


                                <TextBlock Grid.Column="1"
                                           x:Name="TypeValue"
                                           Style="{StaticResource FieldValueStyle}"/>


                                <Button Grid.Column="2"
                                        x:Name="CopyTypeButton"
                                        Content="⧉"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Click="CopyType_Click"
                                        ToolTip="Copy Type"/>

                            </Grid>


                            <!-- MARK -->

                            <Grid x:Name="MarkRow"
                                  Margin="0,2">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="78"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="32"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Grid.Column="0"
                                           Text="Mark"
                                           Style="{StaticResource FieldLabelStyle}"/>


                                <TextBlock Grid.Column="1"
                                           x:Name="MarkValue"
                                           Style="{StaticResource FieldValueStyle}"/>


                                <Button Grid.Column="2"
                                        x:Name="CopyMarkButton"
                                        Content="⧉"
                                        Style="{StaticResource CopyButtonStyle}"
                                        Click="CopyMark_Click"
                                        ToolTip="Copy Mark"/>

                            </Grid>


                            <!-- DYNAMIC PARAMETERS -->

                            <StackPanel x:Name="PinnedParametersPanel"
                                        Margin="0,6,0,0"/>


                            <!-- ADD PARAMETER -->

                            <Button x:Name="AddParameterButton"
                                    Content="+  ADD PARAMETER"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Click="AddParameterButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- ================================================= -->
                <!-- SHORTCUTS MODULE -->
                <!-- ================================================= -->

                <StackPanel x:Name="ShortcutsModule">

                    <TextBlock Text="SHORTCUTS"
                               Style="{StaticResource SectionTitleStyle}"/>


                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <StackPanel x:Name="ToolsPanel"/>


                            <Button x:Name="AddMoreToolsButton"
                                    Content="+  ADD MORE TOOLS"
                                    Style="{StaticResource ActionButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,8,0,0"
                                    Click="AddMoreToolsButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- ================================================= -->
                <!-- HANGERS MODULE -->
                <!-- ================================================= -->

                <StackPanel x:Name="HangersModule">

                    <TextBlock Text="HANGERS"
                               Style="{StaticResource SectionTitleStyle}"/>


                    <Border x:Name="HangerAdjustmentBorder"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8"
                            Margin="0,0,0,14"
                            Visibility="Collapsed">

                        <StackPanel>

                            <TextBlock Text="ROD LENGTH"
                                       Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock Text="Adjustment amount"
                                       Foreground="#999999"
                                       FontSize="10"
                                       Margin="0,0,0,6"/>


                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="38"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="38"/>

                                </Grid.ColumnDefinitions>


                                <!-- DECREASE -->

                                <Button Grid.Column="0"
                                        x:Name="DecreaseRodButton"
                                        Content="−"
                                        Style="{StaticResource SmallActionButtonStyle}"
                                        Click="DecreaseRodButton_Click"
                                        ToolTip="Decrease rod length"/>


                                <!-- VALUE -->

                                <TextBox Grid.Column="1"
                                         x:Name="RodAdjustmentTextBox"
                                         Text="0.50&quot;"
                                         Height="32"
                                         Margin="6,0"
                                         Padding="8,0"
                                         VerticalContentAlignment="Center"
                                         Background="#202020"
                                         Foreground="#F2F2F2"
                                         BorderBrush="#4A4A4A"
                                         BorderThickness="1"
                                         FontSize="12"/>


                                <!-- INCREASE -->

                                <Button Grid.Column="2"
                                        x:Name="IncreaseRodButton"
                                        Content="+"
                                        Style="{StaticResource SmallActionButtonStyle}"
                                        Click="IncreaseRodButton_Click"
                                        ToolTip="Increase rod length"/>

                            </Grid>


                            <TextBlock x:Name="HangerAdjustmentStatus"
                                       Text="Select a fabrication hanger"
                                       Foreground="#777777"
                                       FontSize="10"
                                       Margin="0,7,0,0"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- FUTURE HANGER TOOLS -->

                    <Border x:Name="HangerToolsBorder"
                            Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="8"
                            Margin="0,0,0,14">

                        <StackPanel>

                            <TextBlock Text="TOOLS"
                                       Style="{StaticResource SectionTitleStyle}"/>


                            <TextBlock Text="Hanger tools will appear here."
                                       Foreground="#777777"
                                       FontSize="10"
                                       Margin="0,2,0,4"/>

                        </StackPanel>

                    </Border>

                </StackPanel>


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <TextBlock Text="STATUS"
                           Style="{StaticResource SectionTitleStyle}"/>


                <Border Background="#202020"
                        BorderBrush="#363636"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="8">

                    <TextBlock x:Name="StatusText"
                               Text="No element selected"
                               Foreground="#888888"
                               FontSize="10"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- BOTTOM SPACING -->

                <Border Height="8"
                        Background="Transparent"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Page>