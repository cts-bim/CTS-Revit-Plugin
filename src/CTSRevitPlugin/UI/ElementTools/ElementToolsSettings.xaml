<Window x:Class="CTSRevitPlugin.UI.ElementTools.ElementToolsSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTS Utilities Settings" Width="600" Height="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14">
            <StackPanel>
                <TextBlock Text="CTS UTILITIES" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Configure panes, tools and pinned parameters" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" x:Name="SettingsTabs" Margin="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
            <TabItem Header="GENERAL">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15">
                    <TextBlock Text="HANGERS" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShowHangerRodAdjustmentCheck" Content="Show Rod Length Adjustment"/>
                    <TextBlock Text="The Utilities ribbon menu opens three independent dockable panes: Parameters, Shortcuts and Hangers." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="PARAMETERS">
                <Grid Margin="15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="PINNED PARAMETERS" Grid.Row="0" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ParameterSearchBox" Height="32" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" TextChanged="ParameterSearchBox_TextChanged"/>
                        <Button Grid.Column="1" Content="CLEAR" Width="70" Height="32" Margin="6,0,0,0" Padding="4,0" Click="ClearParameterSearchButton_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterListPanel"/></ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="SHORTCUTS">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15">
                    <TextBlock Text="SHORTCUT TOOLS" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Text="Choose the tools and Revit commands that appear in CTS Shortcuts." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBox x:Name="ShortcutSearchBox" Height="32" Padding="10,0" VerticalContentAlignment="Center" Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,10" TextChanged="ShortcutSearchBox_TextChanged" ToolTip="Search commands"/>
                    <ScrollViewer Height="360" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ShortcutListPanel"/></ScrollViewer>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="HANGERS">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="15">
                    <TextBlock Text="HANGER TOOLS" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                    <TextBlock Text="Choose the tools that appear in CTS Hangers." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <StackPanel x:Name="HangerListPanel"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="FooterCtsLogo" Width="30" Height="30" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="CTS BIM  •  Utilities Settings" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="10,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="CANCEL" Width="85" Click="Cancel_Click"/><Button Content="SAVE" Width="85" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Click="Save_Click"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>