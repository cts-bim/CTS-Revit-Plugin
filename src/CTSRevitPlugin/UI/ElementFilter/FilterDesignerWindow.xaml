<Window x:Class="CTSRevitPlugin.UI.ElementFilter.FilterDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTS Filter Designer"
        Width="860" Height="660"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="CTS FILTER DESIGNER" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="Bold"/>
            <TextBlock Text="Name the filter, pick the categories it applies to, then build the conditions."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- TOP FIELDS -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="NameBox" Height="32" Padding="8,0" VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="MATCH" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="MatchBox" Width="150" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="LOOK IN" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ScopeBox" Width="150" Height="32"/>
            </StackPanel>

            <StackPanel Grid.Column="3">
                <TextBlock Text="DEFAULT ACTION" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="ActionBox" Width="170" Height="32"
                          ToolTip="Run on double-click in the palette."/>
            </StackPanel>
        </Grid>

        <!-- BODY -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.36*"/>
                <ColumnDefinition Width="0.64*"/>
            </Grid.ColumnDefinitions>

            <!-- CATEGORIES -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CATEGORIES" Style="{StaticResource FieldLabel}"/>

                    <TextBox Grid.Row="1" x:Name="CategorySearchBox" Height="28" Padding="7,0" Margin="0,0,0,8"
                             VerticalContentAlignment="Center" FontSize="11"
                             TextChanged="CategorySearchBox_TextChanged"
                             ToolTip="Search categories"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CategoriesPanel"/>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" x:Name="CategoryHint"
                               Text="Nothing ticked means every model category."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- CONDITIONS -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CONDITIONS" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ ADD CONDITION" Style="{StaticResource SmallButton}"
                                Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}"
                                BorderThickness="0" Margin="0" Click="AddCondition_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConditionsPanel"/>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="TRANSPARENCY" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="TransparencyBox" Width="60" Height="28" Padding="6,0"
                                 VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip="0 to 100. Used by the Transparency action."/>
                        <TextBlock Text="%" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterHint" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="CANCEL" Width="96" Height="34" Margin="0,0,8,0"
                        Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" FontSize="11"
                        Click="Cancel_Click"/>
                <Button Content="SAVE" Width="110" Height="34"
                        Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}"
                        BorderThickness="0" FontSize="11" FontWeight="Bold"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
