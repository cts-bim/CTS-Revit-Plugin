<Window x:Class="CTSRevitPlugin.UI.Assemblies.AssemblyBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTS Assembly Builder" Width="1060" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
        </Style>
        <Style x:Key="CtsListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="CtsListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Width="40" Height="40" Stretch="Uniform" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CTS ASSEMBLY BUILDER" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Pick items from the fabrication database and set the order they are modeled in" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: DATABASE -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="FABRICATION DATABASE" Style="{StaticResource SectionHeaderStyle}"/>

                    <!-- Two rows taller than the original 124: SERVICE and PALETTE
                         were showing four entries, which is not enough to tell
                         similar service names apart without scrolling. -->
                    <Grid Grid.Row="1" Height="178">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="SERVICE" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="PALETTE" Style="{StaticResource FieldLabelStyle}"/>
                        <ListBox x:Name="ServiceList" Grid.Row="1" Grid.Column="0" Style="{StaticResource CtsListBoxStyle}" ItemContainerStyle="{StaticResource CtsListItemStyle}" SelectionChanged="ServiceList_SelectionChanged"/>
                        <ListBox x:Name="PaletteList" Grid.Row="1" Grid.Column="2" Style="{StaticResource CtsListBoxStyle}" ItemContainerStyle="{StaticResource CtsListItemStyle}" SelectionChanged="PaletteList_SelectionChanged"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,8">
                        <TextBlock Text="SEARCH" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBox x:Name="SearchBox" Style="{StaticResource InputStyle}" TextChanged="SearchBox_TextChanged" ToolTip="Filter the items of the selected palette by name or code"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="CatalogTilesPanel"/>
                    </ScrollViewer>

                    <TextBlock x:Name="CatalogStatus" Grid.Row="4" Text="Loading the fabrication database..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- RIGHT: ASSEMBLY -->
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ASSEMBLY" Style="{StaticResource SectionHeaderStyle}"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="NAME" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="NameBox" Style="{StaticResource InputStyle}" MaxLength="40"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="TILE (3 LETTERS)" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox x:Name="ShortNameBox" Style="{StaticResource InputStyle}" MaxLength="3" CharacterCasing="Upper"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SEQUENCE (FROM THE FREE END OF THE OLET)" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="AddStepButton" Content="+ ADD ITEM" Margin="0,0,4,0" Padding="10,4" FontSize="10" FontWeight="Bold" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" Click="AddStep_Click" ToolTip="Adds an empty step at the end. Then click the item in the database."/>
                                <Button x:Name="DuplicateStepButton" Content="DUPLICATE" Margin="0" Padding="10,4" FontSize="10" Click="DuplicateStep_Click" ToolTip="Adds a copy of the selected step right after it"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ModeHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <ListBox x:Name="StepsList" Grid.Row="3" Style="{StaticResource CtsListBoxStyle}" ItemContainerStyle="{StaticResource CtsListItemStyle}" SelectionChanged="StepsList_SelectionChanged"/>

                    <Border x:Name="StepSettingsCard" Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="StepSettingsTitle" Text="STEP SETTINGS" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,6"/>

                            <TextBlock Text="SIZE (ONLY USED WHEN NO VARIATION IS PICKED)" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="SizePreviousRadio" GroupName="StepSize" Content="Same as the previous part" Checked="StepSetting_Changed" ToolTip="Uses the size of the olet / previous part"/>
                                <RadioButton x:Name="SizeFixedRadio" GroupName="StepSize" Content="Fixed" Margin="0,0,6,0" Checked="StepSetting_Changed"/>
                                <TextBox x:Name="FixedSizeBox" Style="{StaticResource InputStyle}" Width="70" Height="24" TextChanged="StepSetting_TextChanged" ToolTip="Example: 1/2&quot;"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="ROTATION (DEG)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox x:Name="RotationBox" Style="{StaticResource InputStyle}" Width="90" Height="24" HorizontalAlignment="Left" TextChanged="StepSetting_TextChanged" ToolTip="Turns the part around the connection, e.g. a valve handle"/>
                            </StackPanel>

                            <!-- Product entry. Editable on purpose: Revit only lists a
                                 part's entries once the part exists, so the dropdown is
                                 empty until this assembly has been placed once. Typing
                                 the value exactly as the Properties palette shows it
                                 always works. -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="PRODUCT ENTRY (LEAVE EMPTY TO LET REVIT CHOOSE)" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox x:Name="ProductEntryBox" Height="24" HorizontalAlignment="Left" Width="200"
                                          IsEditable="True" IsTextSearchEnabled="False"
                                          SelectionChanged="ProductEntry_SelectionChanged"
                                          LostFocus="ProductEntry_LostFocus"
                                          ToolTip="Exact product entry, e.g. 3/4x1/8. Needed on reducing parts, where the entry decides the small end the next step connects to."/>
                                <TextBlock x:Name="ProductEntryHint" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>

                            <TextBlock Text="CONNECT THROUGH" Style="{StaticResource FieldLabelStyle}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ConnAutoRadio" GroupName="StepConn" Content="Auto" Checked="StepSetting_Changed" ToolTip="Tries each end and keeps the one that fits without a coupling"/>
                                <RadioButton x:Name="ConnFirstRadio" GroupName="StepConn" Content="First end" Checked="StepSetting_Changed"/>
                                <RadioButton x:Name="ConnSecondRadio" GroupName="StepConn" Content="Second end" Checked="StepSetting_Changed" ToolTip="Use it to flip a nipple or adapter"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="FooterCtsLogo" Width="30" Height="30" Stretch="Uniform" Margin="0,0,12,0"/>
                <TextBlock x:Name="BuilderStatus" Grid.Column="1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="CANCEL" Width="96" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Content="SAVE" Width="96" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
