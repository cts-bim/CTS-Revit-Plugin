<Page x:Class="CTSRevitPlugin.UI.Assemblies.AssembliesPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,10,0,6"/>
        </Style>
        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="82"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="Transparent" CornerRadius="7" Margin="0,0,10,0">
                    <Image x:Name="HeaderLogo" Stretch="Uniform" Margin="5"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CTS ASSEMBLIES" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Pre-built fabrication sequences" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="+" Width="32" Height="32" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="20" FontWeight="SemiBold" Click="NewButton_Click" ToolTip="Create a new assembly"/>
            </Grid>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <TextBlock Text="ASSEMBLIES" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8"/>
                <WrapPanel x:Name="TilesPanel" Margin="0,0,0,4"/>
                <TextBlock x:Name="EmptyText" Text="No assemblies yet. Press + to create one, or IMPORT a file shared by your project lead." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

                <!-- Project sharing: the lead exports one file, the team imports it. -->
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Content="IMPORT" Style="{StaticResource ActionButtonStyle}" Click="ImportButton_Click" ToolTip="Load assemblies from a file shared by your project lead."/>
                    <Button Content="EXPORT" Style="{StaticResource ActionButtonStyle}" Click="ExportButton_Click" ToolTip="Save these assemblies to a file you can send to the rest of the project."/>
                </StackPanel>

                <Border x:Name="DetailsCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,4,0,8" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DetailName" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock x:Name="DetailCount" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="SEQUENCE" Style="{StaticResource FieldLabelStyle}"/>
                        <WrapPanel x:Name="SequencePanel"/>
                        <TextBlock x:Name="DetailWarning" Foreground="{DynamicResource PrimaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

                        <Button x:Name="PlaceButton" Content="BUILD ON SELECTED OLETS" Height="38" Margin="0,12,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderThickness="0" FontSize="12" FontWeight="Bold" Click="PlaceButton_Click" ToolTip="Builds this sequence from the free end of every selected olet."/>
                        <TextBlock Text="Model the olet on the pipe as usual, select it (or several) and press the button. If nothing is selected you are asked to pick them. The sequence follows the direction of each olet and its size."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="EDIT" Style="{StaticResource ActionButtonStyle}" Click="EditButton_Click" ToolTip="Change the items and their order"/>
                            <Button Content="DUPLICATE" Style="{StaticResource ActionButtonStyle}" Click="DuplicateButton_Click" ToolTip="Create a copy to adapt"/>
                            <Button Content="DELETE" Style="{StaticResource ActionButtonStyle}" Click="DeleteButton_Click" ToolTip="Remove this assembly"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,2,0,0">
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="FooterCtsLogo" Width="30" Height="30" Stretch="Uniform"/>
                <Image x:Name="FooterMotto" Grid.Column="1" Height="24" Stretch="Uniform" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>
