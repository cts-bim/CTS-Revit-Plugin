<Page x:Class="CTSRevitPlugin.UI.Utilities.ShortcutsPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Width="38" Height="38" Stretch="Uniform" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CTS SHORTCUTS" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Your most-used Revit commands" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="SettingsButton" Content="⚙" Width="32" Height="32" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="18" Click="SettingsButton_Click" ToolTip="CTS Utilities Settings"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <TextBox x:Name="SearchBox" Height="32" Padding="9,0" VerticalContentAlignment="Center"
                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}" FontSize="11"
                         ToolTip="Search Revit and add-in commands" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="SHORTCUTS" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Bold" Margin="0,14,0,8"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
                    <StackPanel x:Name="ToolsPanel"/>
                </Border>
                <Border Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,14,0,0">
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="FooterCtsLogo" Width="30" Height="30" Stretch="Uniform"/>
                <Image x:Name="FooterMotto" Grid.Column="1" Height="24" Stretch="Uniform" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>
