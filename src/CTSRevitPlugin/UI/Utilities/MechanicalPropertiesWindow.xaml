<Window x:Class="CTSRevitPlugin.UI.Utilities.MechanicalPropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CTS Mechanical Properties" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="6,5"/>
        </Style>
        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="8,12,8,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="HeaderLogo" Width="38" Height="38" Stretch="Uniform" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MECHANICAL PROPERTIES" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="HeaderSubtitle" Text="Deep Revit MEP Fabrication data" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <UniformGrid Columns="4">
                    <StackPanel><TextBlock Text="ELEMENT ID" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="IdText" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="CATEGORY" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="CategoryText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel><TextBlock Text="FAMILY" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="FamilyText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <StackPanel><TextBlock Text="TYPE" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="TypeText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                </UniformGrid>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanel" Margin="5"/>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image x:Name="FooterCtsLogo" Width="30" Height="30"/><Image x:Name="FooterMotto" Grid.Column="1" Height="24" Stretch="Uniform" HorizontalAlignment="Right"/></Grid>
        </Border>
    </Grid>
</Window>