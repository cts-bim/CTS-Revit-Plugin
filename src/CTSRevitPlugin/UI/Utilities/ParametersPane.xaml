<Page x:Class="CTSRevitPlugin.UI.Utilities.ParametersPane"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBackgroundBrush}">
    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="CopyStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ActionStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="11"/>
        </Style>
        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="Transparent" CornerRadius="7" Margin="0,0,10,0">
                    <Image x:Name="HeaderLogo" Stretch="Uniform" Margin="6"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CTS PARAMETERS" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="Element parameters &amp; values" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="SettingsButton" Content="⚙" Width="32" Height="32" Background="Transparent"
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="18" Click="SettingsButton_Click" ToolTip="CTS Utilities Settings"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <TextBlock Text="SELECTED ELEMENT" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Element ID" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="ElementIdValue" Grid.Column="1" Style="{StaticResource ValueStyle}"/>
                        <Button x:Name="CopyElementIdButton" Grid.Column="2" Content="⧉" Style="{StaticResource CopyStyle}" Click="CopyElementId_Click" ToolTip="Copy Element ID"/>
                    </Grid>
                </Border>
                <TextBlock Text="PARAMETERS" Foreground="{DynamicResource TextBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel x:Name="ParametersPanel"/>
                        <Button x:Name="AddParameterButton" Content="+  ADD PARAMETER" Style="{StaticResource ActionStyle}" Click="AddParameterButton_Click"/>
                    </StackPanel>
                </Border>
                <Button x:Name="MechanicalPropertiesButton" Content="◈  MECHANICAL PROPERTIES" Style="{StaticResource AccentButtonStyle}" Click="MechanicalPropertiesButton_Click"
                        ToolTip="Inspect deeper Revit MEP Fabrication properties and hidden parameters." Visibility="Collapsed" Margin="0,0,0,8"/>
                <Border Background="{DynamicResource StatusBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
                    <TextBlock x:Name="StatusText" Text="No element selected" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,7">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image x:Name="FooterCtsLogo" Width="30" Height="30" Stretch="Uniform"/>
                <Image x:Name="FooterMotto" Grid.Column="1" Height="24" Stretch="Uniform" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>